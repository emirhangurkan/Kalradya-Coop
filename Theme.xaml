<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="Bg" Color="#151511"/>
    <SolidColorBrush x:Key="Panel" Color="#F01E201A"/>
    <SolidColorBrush x:Key="Line" Color="#4A4435"/>
    <SolidColorBrush x:Key="Ink" Color="#F0E6CF"/>
    <SolidColorBrush x:Key="Muted" Color="#B9AF98"/>
    <SolidColorBrush x:Key="Gold" Color="#D5B478"/>
    <LinearGradientBrush x:Key="Bronze" StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#D7B77A" Offset="0"/><GradientStop Color="#AC813F" Offset="1"/></LinearGradientBrush>
    <LinearGradientBrush x:Key="Leather" StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#F62A2B22" Offset="0"/><GradientStop Color="#F01B1D18" Offset="1"/></LinearGradientBrush>
    <DrawingImage x:Key="CampaignEmblem">
        <DrawingImage.Drawing><DrawingGroup>
            <GeometryDrawing Brush="#322721" Geometry="M4,5 L36,0 68,5 66,48 Q61,69 36,83 Q11,69 6,48 Z"><GeometryDrawing.Pen><Pen Brush="#C4A163" Thickness="2"/></GeometryDrawing.Pen></GeometryDrawing>
            <GeometryDrawing Brush="#D8CBB1" Geometry="M15,17 L20,19 51,54 48,57 17,22 Z M57,17 L52,19 21,54 24,57 55,22 Z"/>
            <GeometryDrawing Brush="#BD9556" Geometry="M41,54 L46,49 55,59 51,63 Z M17,59 L26,49 31,54 21,63 Z M49,63 L54,59 60,66 55,70 Z M12,66 L18,59 23,63 17,70 Z"/>
            <GeometryDrawing Brush="#D5B478" Geometry="M36,12 L39,17 36,22 33,17 Z"/>
        </DrawingGroup></DrawingImage.Drawing>
    </DrawingImage>
    <Style TargetType="Window"><Setter Property="Background" Value="{StaticResource Bg}"/><Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="FontSize" Value="14"/><Setter Property="UseLayoutRounding" Value="True"/></Style>
    <Style x:Key="Caption" TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Muted}"/><Setter Property="FontSize" Value="10"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
    <Style x:Key="Heading" TargetType="TextBlock"><Setter Property="FontFamily" Value="Georgia"/><Setter Property="FontSize" Value="25"/><Setter Property="Foreground" Value="{StaticResource Ink}"/></Style>
    <Style TargetType="Button">
        <Setter Property="Background" Value="#34362B"/><Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="BorderBrush" Value="#655B43"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="14,10"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
            <Border x:Name="Box" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/></Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Gold}"/><Setter TargetName="Box" Property="Opacity" Value="0.88"/></Trigger>
                <Trigger Property="IsPressed" Value="True"><Setter TargetName="Box" Property="Opacity" Value="0.66"/></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Box" Property="Opacity" Value="0.36"/></Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="#F5DBA2"/><Setter TargetName="Box" Property="BorderThickness" Value="2"/></Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="{DynamicResource Bronze}"/><Setter Property="Foreground" Value="#211B10"/><Setter Property="BorderBrush" Value="{DynamicResource Gold}"/><Setter Property="FontSize" Value="17"/><Setter Property="Padding" Value="20,15"/></Style>
    <Style x:Key="Quiet" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="#221B1D18"/><Setter Property="Foreground" Value="{StaticResource Muted}"/><Setter Property="BorderBrush" Value="{StaticResource Line}"/><Setter Property="Padding" Value="11,8"/><Setter Property="FontSize" Value="12"/></Style>
    <Style TargetType="TextBox"><Setter Property="Background" Value="#141611"/><Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="BorderBrush" Value="#625941"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="11,9"/><Setter Property="CaretBrush" Value="{StaticResource Gold}"/><Setter Property="SelectionBrush" Value="#867047"/><Setter Property="FontSize" Value="14"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
    <Style TargetType="CheckBox"><Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="Margin" Value="0,9"/><Setter Property="FontSize" Value="13"/></Style>
    <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="{StaticResource Leather}"/><Setter Property="BorderBrush" Value="{StaticResource Line}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="4"/><Setter Property="Padding" Value="22"/></Style>
    <Style TargetType="ToolTip"><Setter Property="Background" Value="#27281F"/><Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="BorderBrush" Value="{StaticResource Gold}"/><Setter Property="Padding" Value="12,9"/><Setter Property="FontSize" Value="12"/></Style>
    <Style TargetType="Expander">
        <Setter Property="Foreground" Value="{StaticResource Ink}"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Expander">
            <StackPanel>
                <ToggleButton x:Name="ExpandToggle" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}" HorizontalContentAlignment="Left" Foreground="{StaticResource Muted}" Background="Transparent" Cursor="Hand">
                    <ToggleButton.Template><ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="ToggleBorder" Padding="3,8" BorderThickness="1" BorderBrush="Transparent">
                            <StackPanel Orientation="Horizontal"><TextBlock x:Name="Arrow" Text="＋" Foreground="{DynamicResource Gold}" FontSize="15" Margin="0,0,8,0"/><ContentPresenter Content="{Binding Header, RelativeSource={RelativeSource AncestorType=Expander}}" VerticalAlignment="Center"/></StackPanel>
                        </Border>
                        <ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Arrow" Property="Text" Value="−"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ToggleBorder" Property="BorderBrush" Value="{DynamicResource Gold}"/></Trigger></ControlTemplate.Triggers>
                    </ControlTemplate></ToggleButton.Template>
                </ToggleButton>
                <ContentPresenter x:Name="ExpandedContent" Visibility="Collapsed"/>
            </StackPanel>
            <ControlTemplate.Triggers><Trigger Property="IsExpanded" Value="True"><Setter TargetName="ExpandedContent" Property="Visibility" Value="Visible"/></Trigger></ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="8"/><Setter Property="Background" Value="#181A14"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
            <Grid Background="{TemplateBinding Background}">
                <Track x:Name="PART_Track" Orientation="{TemplateBinding Orientation}" IsDirectionReversed="True">
                    <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/></Track.DecreaseRepeatButton>
                    <Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="#6E6248" CornerRadius="3" Margin="1"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
                    <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/></Track.IncreaseRepeatButton>
                </Track>
            </Grid>
            <ControlTemplate.Triggers><Trigger Property="Orientation" Value="Horizontal"><Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/></Trigger></ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
        <Style.Triggers><Trigger Property="Orientation" Value="Horizontal"><Setter Property="Width" Value="Auto"/><Setter Property="Height" Value="8"/></Trigger></Style.Triggers>
    </Style>
</ResourceDictionary>
