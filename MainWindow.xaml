<Window x:Class="KalradyaCoop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Bannerlord • Kalradya Co-op" Width="960" Height="820" MinWidth="760" MinHeight="640" WindowStartupLocation="CenterScreen" Style="{StaticResource {x:Type Window}}">
    <Grid>
        <Image Source="Assets/calradia-campaign.png" Stretch="UniformToFill" Height="600" VerticalAlignment="Top" Opacity="0.7" IsHitTestVisible="False"/>
        <Border IsHitTestVisible="False"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#B8151511" Offset="0"/><GradientStop Color="#55151511" Offset="0.4"/><GradientStop Color="#FF151511" Offset="0.85"/></LinearGradientBrush></Border.Background></Border>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="32,24,32,24">
                <Grid Margin="0,0,0,24">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Image x:Name="BannerImage" Width="52" Height="65" Margin="0,0,16,0" IsHitTestVisible="False"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Mount &amp; Blade II" FontFamily="Georgia" FontSize="15" Foreground="{DynamicResource Gold}"/><TextBlock Text="BANNERLORD" FontFamily="Georgia" FontSize="29" Margin="-1,2,0,1"/><TextBlock Text="Kalradya Co-op" Foreground="{StaticResource Muted}" FontSize="12"/></StackPanel>
                    <Button x:Name="AppearanceButton" Grid.Column="2" Content="Görünüm" Style="{StaticResource Quiet}" Click="Appearance_Click" VerticalAlignment="Top" AutomationProperties.Name="Sancak ve renk seç"/>
                </Grid>
                <TextBlock Text="Bugün kim açıyor?" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,11"/>
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <Button x:Name="HostModeButton" Content="Ben açacağım" FontSize="17" Padding="16,16" Click="HostMode_Click"/>
                    <Button x:Name="JoinModeButton" Grid.Column="2" Content="Arkadaşıma katılacağım" FontSize="17" Padding="16,16" Click="JoinMode_Click"/>
                </Grid>
                <Border x:Name="HostPanel" Style="{StaticResource Card}" Padding="26">
                    <StackPanel>
                        <TextBlock x:Name="HeroTitle" Text="Birlikte devam edelim." Style="{StaticResource Heading}" Margin="0,0,0,10"/>
                        <TextBlock x:Name="HeroSubtitle" Text="Son kaydın kontrol ediliyor…" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,16"/>
                        <Button x:Name="PlayButton" Content="Oyunu başlat" Click="Play_Click" Style="{StaticResource Primary}" MinHeight="57"/>
                        <TextBlock x:Name="HostHint" Text="Sunucu hazırlanır, ardından oyun açılır." Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,10,0,0"/>
                        <WrapPanel x:Name="CampaignActions" Margin="0,16,0,0">
                            <Button x:Name="NewGameButton" Content="＋ Yeni oyun başlat" Click="NewGame_Click" Style="{StaticResource Quiet}" Margin="0,0,8,6"/>
                            <Button x:Name="PickGameButton" Content="Kayıt seç" Click="PickGame_Click" Style="{StaticResource Quiet}" Margin="0,0,8,6"/>
                            <Button x:Name="DifficultyButton" Content="Zorluk ve oyun ayarları" Click="Difficulty_Click" Style="{StaticResource Quiet}" Margin="0,0,0,6"/>
                        </WrapPanel>
                        <StackPanel x:Name="ActiveHostPanel" Visibility="Collapsed">
                            <Border Background="#88141611" CornerRadius="4" Padding="12" Margin="0,14,0,14">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center"><TextBlock Text="Oyunda sen bunu kullan" FontWeight="SemiBold" Margin="0,0,0,5"/><TextBlock Text="Join Co-op Sandbox → Direct" Foreground="{StaticResource Muted}" FontSize="12"/></StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal"><TextBlock x:Name="LocalIpText" FontFamily="Consolas" FontSize="15" VerticalAlignment="Center" Margin="12,0,12,0"/><Button Content="Kopyala" AutomationProperties.Name="Kendi IP adresini kopyala" Click="CopyLocal_Click" Style="{StaticResource Quiet}"/></StackPanel>
                                </Grid>
                            </Border>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="Arkadaşlarının yazacağı IP" Style="{StaticResource Caption}" FontSize="12" Margin="0,0,0,5"/><TextBox x:Name="IpText" IsReadOnly="True" FontFamily="Consolas" AutomationProperties.Name="Arkadaşların için IP"/></StackPanel>
                                <StackPanel Grid.Column="2"><TextBlock Text="Herkesin yazacağı şifre" Style="{StaticResource Caption}" FontSize="12" Margin="0,0,0,5"/><TextBox x:Name="PasswordText" IsReadOnly="True" FontFamily="Consolas" AutomationProperties.Name="Oyun şifresi"/></StackPanel>
                            </Grid>
                            <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <Button x:Name="ShareButton" Content="IP ve şifreyi birlikte kopyala" Click="Share_Click" IsEnabled="False" ToolTip="Kopyalanan mesajı arkadaşlarına gönder."/>
                                <Button x:Name="InviteButton" Grid.Column="2" Content="Tailscale daveti ekle" Click="Invite_Click" Style="{StaticResource Quiet}" ToolTip="İlk kez katılan arkadaşın için davet linkini ekle."/>
                            </Grid>
                        </StackPanel>
                        <Button x:Name="StopButton" Content="Herkes çıktıysa: kaydet ve kapat" Margin="0,22,0,0" Background="#382A23" BorderBrush="#6E5140" Foreground="#E2BFA0" Click="Stop_Click" Visibility="Collapsed" IsEnabled="False"/>
                    </StackPanel>
                </Border>
                <Border x:Name="JoinPanel" Style="{StaticResource Card}" Padding="26" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="Arkadaşının oyununa gir." Style="{StaticResource Heading}"/>
                        <TextBlock Text="Önce arkadaşının gönderdiği IP ve şifre mesajını kopyala." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,9,0,18"/>
                        <Button x:Name="PasteJoinButton" Content="1. Mesajı buraya yapıştır" Click="PasteJoin_Click" FontSize="16" Padding="16,13"/>
                        <Expander x:Name="JoinFields" Header="IP ve şifreyi göster / kendim yazacağım" Margin="0,13,0,14">
                            <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="Arkadaşının IP adresi" Style="{StaticResource Caption}" FontSize="12" Margin="0,0,0,5"/><TextBox x:Name="JoinAddress" FontFamily="Consolas" AutomationProperties.Name="Arkadaşının IP adresi"/><Button Content="IP'yi kopyala" Click="CopyJoinAddress_Click" Style="{StaticResource Quiet}" Margin="0,6,0,0"/></StackPanel>
                                <StackPanel Grid.Column="2"><TextBlock Text="Oyun şifresi" Style="{StaticResource Caption}" FontSize="12" Margin="0,0,0,5"/><TextBox x:Name="JoinPassword" FontFamily="Consolas" AutomationProperties.Name="Arkadaşının oyun şifresi"/><Button Content="Şifreyi kopyala" Click="CopyJoinPassword_Click" Style="{StaticResource Quiet}" Margin="0,6,0,0"/></StackPanel>
                            </Grid>
                        </Expander>
                        <Button x:Name="AcceptInviteButton" Content="İlk kez katılıyorsan: Tailscale davetini kabul et" Click="AcceptInvite_Click" Style="{StaticResource Quiet}" Margin="0,0,0,16" Visibility="Collapsed"/>
                        <Button x:Name="JoinPlayButton" Content="2. Oyunu aç" Click="JoinPlay_Click" Style="{StaticResource Primary}" MinHeight="57"/>
                        <TextBlock Text="Oyunda: Join Co-op Sandbox → Direct → IP ve şifre → Join" Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,12,0,0"/>
                    </StackPanel>
                </Border>
                <StackPanel x:Name="SaveCard" Margin="3,16,3,0">
                    <TextBlock x:Name="SaveTime" Text="Son kayıt kontrol ediliyor…" FontSize="13"/>
                    <TextBlock x:Name="SaveDetail" Text="" Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,5,0,0"/>
                </StackPanel>
                <ProgressBar x:Name="BusyBar" Height="3" Margin="0,16,0,10" IsIndeterminate="True" Visibility="Hidden" Foreground="{DynamicResource Gold}" Background="#343425"/>
                <TextBlock x:Name="Notice" Text="" Foreground="{StaticResource Muted}" FontSize="13" TextWrapping="Wrap" Margin="3,0,3,12"/>
                <Expander Header="Diğer işlemler" Margin="0,0,0,16">
                    <Border Style="{StaticResource Card}" Padding="18" Margin="0,12,0,0">
                        <StackPanel>
                            <StackPanel x:Name="HostTools">
                                <TextBlock Text="Bu kez başka bilgisayar açacaksa" FontWeight="SemiBold"/>
                                <TextBlock Text="Önce kaydı gönder. Arkadaşın kendi programından bu dosyayı açsın." Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,10"/>
                                <WrapPanel><Button x:Name="ExportWorldButton" Content="Kaydı arkadaşıma gönder" Click="ExportWorld_Click" Style="{StaticResource Quiet}" Margin="0,0,8,8"/><Button x:Name="ImportWorldButton" Content="Arkadaşımdan gelen kaydı aç" Click="ImportWorld_Click" Style="{StaticResource Quiet}" Margin="0,0,0,8"/></WrapPanel>
                                <WrapPanel Margin="0,6,0,18"><Button x:Name="StartButton" Content="Yalnızca sunucuyu aç" Click="Start_Click" Style="{StaticResource Quiet}" Margin="0,0,8,8"/><Button x:Name="SaveButton" Content="Şimdi kaydet" Click="Save_Click" Style="{StaticResource Quiet}" Margin="0,0,8,8"/><Button x:Name="BackupsButton" Content="Yedekler" Click="Backups_Click" Style="{StaticResource Quiet}" Margin="0,0,0,8"/></WrapPanel>
                            </StackPanel>
                            <WrapPanel><Button x:Name="SetupButton" Content="İlk kurulum" Click="Setup_Click" Style="{StaticResource Quiet}" Margin="0,0,8,8"/><Button x:Name="RepairButton" Content="Bağlantıyı kontrol et" Click="Repair_Click" Style="{StaticResource Quiet}" Margin="0,0,8,8"/><Button Content="Şifre ve ayarlar" Click="Settings_Click" Style="{StaticResource Quiet}" Margin="0,0,8,8"/><Button Content="Hata kayıtları" Click="Logs_Click" Style="{StaticResource Quiet}" Margin="0,0,0,8"/></WrapPanel>
                            <TextBlock x:Name="CompatibilityText" Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>
                </Expander>
                <WrapPanel Margin="3,0,0,0"><TextBlock x:Name="ServerStatus" Text="Kontrol ediliyor" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,0,20,5"/><TextBlock x:Name="NetworkStatus" Text="" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,0,20,5"/><TextBlock x:Name="PlayersStatus" Text="" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,0,0,5"/></WrapPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
