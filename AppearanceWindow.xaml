<Window x:Class="KalradyaCoop.AppearanceWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Sancak ve renk" Width="560" Height="660" MinWidth="500" MinHeight="580" WindowStartupLocation="CenterOwner" Style="{StaticResource {x:Type Window}}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="26">
            <TextBlock Text="Kendi sancağını seç." Style="{StaticResource Heading}"/>
            <TextBlock Text="Bu programın görünümünü değiştirir. Oyundaki sancağı etkilemez." Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,18"/>
            <Border Style="{StaticResource Card}" Padding="18" Margin="0,0,0,20">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <Image x:Name="PreviewImage" Width="68" Height="84" Margin="0,0,24,0"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="BANNERLORD" FontFamily="Georgia" FontSize="22" Margin="0,0,0,12"/><Border x:Name="PreviewAction" CornerRadius="3" Padding="12,9"><TextBlock Text="Oyunu başlat" Foreground="#211B10" FontWeight="SemiBold" HorizontalAlignment="Center"/></Border></StackPanel>
                </Grid>
            </Border>
            <TextBlock Text="Sancak" FontWeight="SemiBold" Margin="0,0,0,9"/>
            <UniformGrid x:Name="SymbolChoices" Rows="1" Columns="4" Margin="0,0,-8,18"/>
            <TextBlock Text="Renk" FontWeight="SemiBold" Margin="0,0,0,9"/>
            <UniformGrid x:Name="ColorChoices" Rows="1" Columns="4" Margin="0,0,-8,18"/>
            <TextBlock x:Name="SelectionText" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,0,0,12"/>
            <TextBlock x:Name="ErrorText" Foreground="#F3ABAE" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8"/>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions><Button Content="Vazgeç" Click="Cancel_Click" IsCancel="True"/><Button Grid.Column="2" Content="Uygula" Click="Save_Click" IsDefault="True" Style="{StaticResource Primary}" Padding="14,10"/></Grid>
        </StackPanel>
    </ScrollViewer>
</Window>
